{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/lectura.js": {
      "maxDuration": 60,
      "includeFiles": "{quizzes/**,site.json,productos.json}"
    },
    "api/checkout.js": {
      "maxDuration": 20,
      "includeFiles": "{quizzes/**,site.json,productos.json}"
    },
    "api/informe.js": {
      "maxDuration": 90,
      "includeFiles": "{quizzes/**,site.json,productos.json}"
    },
    "api/suscribir.js": {
      "maxDuration": 10
    },
    "api/opinion.js": {
      "maxDuration": 15
    },
    "api/pdf.js": {
      "maxDuration": 30,
      "includeFiles": "{fonts/pdf/**,img/pdf/**,quizzes/**,site.json,productos.json}"
    }
  }
}
